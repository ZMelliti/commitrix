{
  "name": "commitrix",
  "version": "0.5.1",
  "description": "Git commit quality linter",
  "main": "src/index.js",
  "bin": {
    "commitrix": "src/index.js"
  },
  "scripts": {
    "test": "jest --coverage",
    "install-hook": "node src/install-hook.js",
    "postinstall": "node src/install-hook.js",
    "prepare": "npm run install-hook && husky install",
    "lint": "eslint src test --ext .js",
    "lint:fix": "eslint --fix src test --ext .js",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "git",
    "commit",
    "linter"
  ],
  "author": "zmelliti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmelliti/commitrix.git"
  },
  "homepage": "https://github.com/zmelliti/commitrix#readme",
  "bugs": {
    "url": "https://github.com/zmelliti/commitrix/issues"
  },
  "files": [
    "src/",
    "README.md",
    "package-lock.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "inquirer": "^12.9.6"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^29.6.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "src/**/*.js": [
      "npm run lint:fix",
      "git add"
    ],
    "test/**/*.js": [
      "npm run lint:fix",
      "git add"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
